        "format": "bunx @biomejs/biome format --write src"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.13",
        "@types/bun": "latest",
        "bun-types": "^1.3.13",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.21.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.16",
        "pg": "^8.20.0",
        "zod": "^4.4.1"
    }
